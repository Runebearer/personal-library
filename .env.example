# Copiez ce fichier en .env.local et remplissez avec la config de votre projet Firebase
# (Console Firebase > Paramètres du projet > Vos applications > Config SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optionnel : clé Google Books (secours si Open Library ne trouve pas le livre)
# (Google Cloud Console > API et services > Identifiants)
VITE_GOOGLE_BOOKS_API_KEY=
