rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      match /shelves/{shelfId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        match /books/{bookId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }
    }
  }
}
